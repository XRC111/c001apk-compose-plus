{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        // 不引用 signingConfigs（此处为空）：产出未签名 HAP，真机安装需在 DevEco 配签名
        "name": "default",
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildModeName": "debug"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
